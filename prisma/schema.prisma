// قاعدة بيانات دفتر مجالس المشايخ — PostgreSQL (Neon) على Vercel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// role: admin | user — aiAllowed: يقدر يولّد جلسات بالذكاء الاصطناعي (المدير يعتمده)
model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("user")
  aiAllowed    Boolean  @default(false)
  /// approved: الحساب يدخل الموقع. التسجيل من صفحة «سجّل الحين» ينشئه false لين يوافق المدير.
  /// الافتراضي true عشان الحسابات الموجودة (والمدير) ما تنقفل مع التحديث.
  approved     Boolean  @default(true)
  /// تعريف المستخدم بنفسه وطلابه، يساعد الذكاء الاصطناعي يفصّل الأسئلة عليه
  about        String   @default("")
  createdAt    DateTime @default(now())
  majalis      Majlis[]
  aiJobs       AiJob[]
}

/// مجلس مع شيخ
model Majlis {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheikh    String
  topic     String     @default("")
  /// YYYY-MM-DD
  date      String     @default("")
  place     String     @default("")
  /// التحضير والافتتاح (نص بتنسيق بسيط)
  opening   String     @default("")
  /// عن الشيخ (نص بتنسيق بسيط)
  briefing  String     @default("")
  books     String     @default("")
  general   String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]

  @@index([userId])
}

/// grp: core | ask | spare
model Question {
  id        String   @id @default(cuid())
  majlisId  String
  majlis    Majlis   @relation(fields: [majlisId], references: [id], onDelete: Cascade)
  text      String
  why       String   @default("")
  grp       String   @default("core")
  pos       Int      @default(0)
  asked     Boolean  @default(false)
  answer    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([majlisId])
}

model Setting {
  key   String @id
  value String
}

/// توليد جلسة بالذكاء الاصطناعي على مراحل: research ← brief ← plan ← saved
model AiJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheikh    String
  hint      String   @default("")
  topic     String   @default("")
  status    String   @default("new")
  research  Json?
  brief     Json?
  plan      Json?
  majlisId  String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
